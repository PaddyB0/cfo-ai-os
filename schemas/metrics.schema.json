{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cfo-ai-os neutral metric list",
  "description": "The connector-neutral metric list the catalogue is built from. A connector adapter produces it.",
  "type": "object",
  "required": [
    "metrics"
  ],
  "properties": {
    "_note": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Where the list came from, in words."
    },
    "core_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dimensions every metric has; the catalogue lists only the others."
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "rollup",
          "dimensions"
        ],
        "properties": {
          "id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "base",
              "calculated"
            ]
          },
          "rollup": {
            "enum": [
              "sum",
              "end_of_period",
              "average",
              "none"
            ],
            "description": "How months roll up to quarters and years."
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "formula": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "warning": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
